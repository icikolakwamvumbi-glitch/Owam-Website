                    </p>

                    <p>
                        <label for="enquiry-type">
                            Enquiry Type:
                        </label><br>

                        <select id="enquiry-type"
                                name="enquiry-type">

                            <option value="private-viewing">
                                Private Viewing
                            </option>

                            <option value="vehicle-enquiry">
                                Vehicle Enquiry
                            </option>

                            <option value="financing">
                                Financing
                            </option>

                            <option value="trade-in">
                                Trade-In
                            </option>

                            <option value="concierge">
                                Concierge Services
                            </option>

                            <option value="collaboration">
                                Collaboration
                            </option>

                        </select>

                    </p>

                    <p>
                        <label for="message">Message:</label><br>

                        <textarea id="message"
                                  name="message"
                                  rows="8"
                                  cols="50"
                                  placeholder="Tell us how we can assist you..."></textarea>

                    </p>

                    <p>
                        <button type="submit">
                            Submit Enquiry
                        </button>

                        <button type="reset">
                            Clear Form
                        </button>

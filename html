             ********************************************************************************************-->

        <section id="contact">

            <h2>Contact Velora Motors</h2>

            <p>
                Interested in a vehicle from our collection?
                Contact us to make an enquiry or request a private
                viewing.
            </p>

            <form action="#" method="post">

                <fieldset>

                    <legend>Private Viewing / General Enquiry</legend>

                    <p>
                        <label for="name">Full Name:</label><br>
                        <input type="text"
                               id="name"
                               name="name"
                               required>
                    </p>

                    <p>
                        <label for="email">Email Address:</label><br>
                        <input type="email"
                               id="email"
                               name="email"
                               required>
                    </p>

                    <p>
                        <label for="phone">Phone Number:</label><br>
                        <input type="tel"
                               id="phone"
                               name="phone">
                    </p>

                    <p>
                        <label for="vehicle">Vehicle of Interest:</label><br>

                        <select id="vehicle" name="vehicle">

                            <option value="">
                                Select a vehicle
                            </option>

                            <option value="ferrari-296-gtb">
                                Ferrari 296 GTB
                            </option>

                            <option value="rolls-royce-ghost">
                                Rolls-Royce Ghost
                            </option>

                            <option value="bentley-bentayga">
                                Bentley Bentayga
                            </option>

                            <option value="range-rover-autobiography">
                                Range Rover Autobiography
                            </option>

                            <option value="aston-martin-db12-volante">
                                Aston Martin DB12 Volante
                            </option>

                            <option value="lamborghini-huracan">
